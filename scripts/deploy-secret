#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $0 HOST SECRET_NAME LOCAL_FILE" >&2
  echo "SECRET_NAME must be tailscale_auth_key or beszel-env" >&2
  exit 2
}

[[ $# -eq 3 ]] || usage

host=$1
secret_name=$2
source_file=$3

[[ -n "$host" && "$host" != -* ]] || usage
case "$secret_name" in
  tailscale_auth_key|beszel-env) ;;
  *) usage ;;
esac

[[ -f "$source_file" && -r "$source_file" && -s "$source_file" ]] || {
  echo "Secret file must be a readable, non-empty regular file: $source_file" >&2
  exit 1
}

remote_path="/var/lib/secrets/$secret_name"
remote_command="sudo -n sh -c 'set -eu; install -d -o root -g root -m 0700 /var/lib/secrets; tmp=\$(mktemp /var/lib/secrets/.${secret_name}.XXXXXX); if cat > \"\$tmp\" && chown root:root \"\$tmp\" && chmod 0400 \"\$tmp\" && mv -f \"\$tmp\" \"$remote_path\"; then :; else rm -f \"\$tmp\"; exit 1; fi'"

printf 'Deploying %s to %s:%s (contents are not displayed).\n' \
  "$secret_name" "$host" "$remote_path"
echo "The SSH account must be able to run sudo -n."
ssh -T "$host" "$remote_command" < "$source_file"
